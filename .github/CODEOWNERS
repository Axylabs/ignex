# Default owners for everything in this repository.
#
# Replace `@Axylabs/maintainers` with the real GitHub team handle (org team
# slug) if it differs — CODEOWNERS silently matches nothing when the handle
# does not exist, so verify it once in repository settings.
#
# Reviews are requested automatically from these owners; the paths below call
# out the surfaces where a mistake is expensive (public API, generated output,
# release/CI machinery).

*                       @Axylabs/maintainers

# Public API + published surface: add/remove subpaths deliberately and
# re-freeze with `bun scripts/check-consistency.ts --update`.
/packages/*/src/index.ts        @Axylabs/maintainers
/packages/*/src/publ/           @Axylabs/maintainers
/scripts/api-surface.json       @Axylabs/maintainers

# Compiler codegen: touches generated output + the cache-version contract.
/packages/compiler/src/phases/  @Axylabs/maintainers

# Native bridge: the only place castrum may be imported.
/packages/native/src/           @Axylabs/maintainers

# Release, CI and supply chain.
/scripts/release.ts             @Axylabs/maintainers
/.release.json                  @Axylabs/maintainers
/.github/                       @Axylabs/maintainers
