{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@ignex/shared": ["./packages/shared/src/index.ts"],
      "@ignex/core": ["./packages/core/src/index.ts"],
      "@ignex/core/http": ["./packages/core/src/http/route.ts"],
      "@ignex/core/env": ["./packages/core/src/platform/env-config.ts"],
      "@ignex/core/*": ["./packages/core/src/*"],
      "@ignex/compiler": ["./packages/compiler/src/index.ts"],
      "@ignex/native": ["./packages/native/src/index.ts"],
      "@ignex/test-utils": ["./packages/test-utils/src/index.ts"],
      "castrum": ["./packages/native/src/vendor/castrum.d.ts"],
      "@ignex/nova/server": ["./packages/core/src/vendor/nova.d.ts"],
      "@ignex/nova/events": ["./packages/core/src/vendor/nova.d.ts"]
    },
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "packages/*/src",
    "packages/app/builder.ts",
    "packages/app/vitest.config.ts",
    "packages/app/test",
    "scripts"
  ],
  "exclude": ["node_modules", "**/dist", "packages/app/dist", "packages/cli"]
}
