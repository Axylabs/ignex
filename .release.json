{
  "product": "ignex",
  "type": "workspace",
  "packageDir": "packages",
  "dependencyScope": "@ignex/",
  "selectChanged": true,
  "lockfile": "bun",
  "verify": ["bun run verify"],
  "checks": ["bun run check:cache-versions", "bun run check:consistency"],
  "versionFiles": [
    { "type": "changelog", "file": "CHANGELOG.md", "unreleased": "## [Unreleased]" }
  ],
  "postBump": ["bun install"],
  "publish": { "strategy": "local", "manager": "bun" }
}
