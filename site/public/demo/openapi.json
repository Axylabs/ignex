        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orderId",
                  "quantity",
                  "totalCents"
                ],
                "properties": {
                  "orderId": {
                    "type": "string"
                  },
                  "quantity": {
