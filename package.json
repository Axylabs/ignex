{
  "name": "ignex",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:cli": "tsc --noEmit -p packages/cli/tsconfig.json",
    "verify": "bun run typecheck && bun run typecheck:cli && bun run lint && bun run test && bun run jsdoc:check:strict",
    "verify:full": "bun run typecheck && bun run typecheck:cli && bun run lint && bun run test:coverage && bun run jsdoc:check:strict && bun run build && bun run smoke && bun run smoke:fallback && bun run check:cache-versions",
    "jsdoc:check": "bun scripts/check-jsdoc.ts",
    "jsdoc:check:strict": "bun scripts/check-jsdoc.ts --strict",
    "lint": "oxlint . && biome check .",
    "lint:fix": "oxlint --fix . && biome check --write .",
    "test": "vitest run",
    "test:all": "bun run test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:core": "vitest run packages/core/test",
    "test:compiler": "bun run --cwd packages/compiler test",
    "test:native": "bun run --cwd packages/native test",
    "test:native:real": "bunx vitest run packages/native/test --no-file-parallelism",
    "verify:native:route": "bun scripts/verify-native-route.ts",
    "verify:native:ffi": "bun scripts/verify-native-ffi.ts",
    "verify:aot:rbac": "bun scripts/verify-aot-rbac.ts",
    "verify:cli:resource": "bun scripts/verify-cli-resource.ts",
    "check:cache-versions": "bun scripts/check-cache-versions.ts",
    "scan:secrets": "bun scripts/scan-secrets.ts",
    "test:cli": "bun run --cwd packages/cli test",
    "test:mcp": "bun run --cwd packages/mcp test",
    "test:shared": "vitest run packages/shared/test",
    "build": "bun run --cwd packages/app build",
    "smoke": "bun scripts/smoke.ts",
    "smoke:fallback": "IGNEX_NATIVE=off bun scripts/smoke.ts",
    "dev": "bun run build && bun --cwd packages/app --watch dist/__server.js",
    "start": "bun --cwd packages/app dist/__server.js",
    "compile": "bun --cwd packages/app builder.ts --compile --binary-outfile ignex-server",
    "openapi:client": "bun scripts/generate-openapi-client.ts",
    "sdk": "bun scripts/generate-sdk.ts",
    "sdk:push": "bun scripts/generate-sdk.ts --push",
    "sdk:publish": "bun scripts/generate-sdk.ts --publish",
    "sdk:release": "bun scripts/generate-sdk.ts --release",
    "bench": "bun scripts/benchmark.ts",
    "bench:native": "bun scripts/native-bench.ts",
    "bench:jwt": "bun scripts/bench-jwt.ts",
    "bench:jwt:compare": "bun scripts/bench-jwt-compare.ts",
    "bench:ffi": "bun scripts/bench-ffi.ts",
    "bench:native:all": "bun scripts/bench-native.ts",
    "bench:bun-internals": "bun scripts/bench-bun-internals.ts",
    "bench:server": "bun scripts/bench-server.ts",
    "bench:server:check": "bun scripts/check-server-bench.ts",
    "bench:compare": "bun bench/compare/run-bench.ts",
    "bench:compare:verify": "bun bench/compare/verify-contract.ts",
    "bench:compare:smoke": "bun bench/compare/run-bench.ts smoke",
    "bench:compare:stress": "bun bench/compare/run-bench.ts stress",
    "bench:compare:heavy": "bun bench/compare/run-bench.ts heavy",
    "bench:compare:crud": "bun bench/compare/run-bench.ts crud",
    "bench:compare:soak": "bun bench/compare/run-bench.ts soak",
    "bench:compare:check": "bun scripts/check-compare-bench.ts",
    "verify:perf": "bun run bench:server:check && bun run bench:compare:check",
    "bench:realworld": "bun scripts/bench-realworld.ts",
    "bench:hotpath": "bun scripts/bench-hotpath.ts",
    "bench:server:routes": "bun scripts/bench-server-routes.ts",
    "fuzz:malformed": "bun scripts/fuzz-malformed-input.ts",
    "bench:products": "oha http://localhost:3000/products/123",
    "release": "bun scripts/publish.ts",
    "release:dry": "bun scripts/publish.ts --dry-run",
    "release:bump": "bun scripts/publish.ts --no-publish",
    "verify:nova": "bun scripts/verify-nova-plugin.ts",
    "verify:drizzle": "bun scripts/verify-drizzle-resource.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@elysia/cors": "^1.4.2",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "expect-type": "^1.4.0",
    "fast-check": "^4.9.0",
    "jose": "^6.2.9",
    "lefthook": "^2.1.10",
    "oxc-parser": "^0.140.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@ignex/nova": "0.1.1",
    "croner": "^10.0.1"
  }
}
