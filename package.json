{
  "name": "flux-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && biome check .",
    "lint:fix": "oxlint --fix . && biome check --write .",
    "test": "bun run --cwd packages/app test",
    "test:watch": "vitest",
    "build": "bun run --cwd packages/app build",
    "smoke": "bun run --cwd packages/app smoke",
    "dev": "bun run build && bun run --cwd packages/app --watch dist/__server.js",
    "start": "bun --cwd packages/app dist/__server.js",
    "compile": "bun build dist/__server.js --compile --minify --target=bun --outfile=flux-server",
    "gen:client": "bun scripts/generate-openapi-client.ts",
    "bench": "bun scripts/benchmark.ts",
    "bench:products": "oha http://localhost:3000/products/123",
    "bench:k6": "k6 run scripts/k6.js",
    "test:vitest": "vitest run",
    "test:ui": "vitest --ui",
    "openapi:client": "bun scripts/generate-openapi-client.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/bun": "^1.3.14",
    "@types/set-cookie-parser": "^2.4.10",
    "@vitest/ui": "^4.1.10",
    "expect-type": "^1.4.0",
    "oxlint": "^1.74.0",
    "tinybench": "^6.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
