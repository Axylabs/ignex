# A/B build variants produced by the bench harness (dist-a, dist-abl, ...)
# are build artifacts, not sources — they must never be linted or committed.
bench/compare/servers/*/dist-*/
.pre-monorepo-*
.trash-packages-*
*.pre-monorepo
.backup-*
# Perf-bench run output is transient — except the regression baseline, which
# check-server-bench.ts compares latest.json against. The pattern must ignore
# the DIRECTORY CONTENTS (not the directory itself): git cannot re-include a
# file whose parent directory is excluded, which is why `bench/results/server`
# alone silently made the negation below dead.
bench/results/server/*
!bench/results/server/baseline.json
.npmrc
.npm-tmp-cache/
bench/results/compare/*
.bun-tmp
.ignex
# Debugbar SPA build staging (scripts/gen-debug-ui.ts)
.gen-debug-ui-*
# Workspace-local package-manager caches (used when ~/.bun is unavailable)
.bun-install/

# throwaway DX dogfood app (docs/dx-improvement-plan.md)
.dx-eval
