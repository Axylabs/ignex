{
  "name": "@flux/cli",
  "version": "0.1.0",
  "description": "CLI for Flux: build, watch, scaffold routes and apps",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flux": "./bin/flux.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@flux/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}