{
  "name": "@ignex/cli",
  "version": "0.1.28",
  "description": "CLI for Ignex: build, watch, scaffold routes and apps",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ignex": "./bin/ignex.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./route": "./src/route.ts",
    "./bin/*": "./bin/*"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@ignex/compiler": "workspace:*",
    "@ignex/core": "workspace:*",
    "@ignex/mcp": "workspace:*",
    "@ignex/native": "workspace:*",
    "citty": "^0.2.2",
    "typebox": "^1.3.25"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  }
}
