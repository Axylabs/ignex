{
  "name": "@ignex/cli",
  "version": "0.2.6",
  "description": "CLI for Ignex: build, watch, scaffold routes and apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axylabs/ignex.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Axylabs/ignex#readme",
  "bugs": {
    "url": "https://github.com/Axylabs/ignex/issues"
  },
  "keywords": [
    "ignex",
    "bun",
    "cli",
    "scaffold",
    "aot",
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "ignex": "./bin/ignex.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./route": "./src/route.ts",
    "./bin/*": "./bin/*"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@ignex/compiler": "workspace:*",
    "@ignex/core": "workspace:*",
    "@ignex/native": "workspace:*",
    "@ignex/shared": "workspace:*",
    "citty": "^0.2.2",
    "typebox": "^1.4.6"
  },
  "peerDependencies": {
    "@ignex/mcp": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@ignex/mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  }
}
