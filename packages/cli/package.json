{
  "name": "@flux/cli",
  "version": "0.1.0",
  "description": "CLI for Flux: build, watch, scaffold routes and apps",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flux": "./bin/flux.js"
  },
