{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@flux/shared": ["../shared/src/index.ts"],
      "@flux/core": ["../core/src/index.ts"],
      "@flux/core/http": ["../core/src/http/route.ts"],
      "@flux/core/*": ["../core/src/*"],
      "@flux/compiler": ["../compiler/src/index.ts"],
      "@flux/native": ["../native/src/index.ts"],
      "castrum": ["../native/src/vendor/castrum.d.ts"]
    }
  },
  "include": ["src"]
}
