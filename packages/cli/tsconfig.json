{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@ignus/shared": ["../shared/src/index.ts"],
      "@ignus/core": ["../core/src/index.ts"],
      "@ignus/core/http": ["../core/src/http/route.ts"],
      "@ignus/core/*": ["../core/src/*"],
      "@ignus/compiler": ["../compiler/src/index.ts"],
      "@ignus/native": ["../native/src/index.ts"],
      "castrum": ["../native/src/vendor/castrum.d.ts"]
    }
  },
  "include": ["src"]
}
