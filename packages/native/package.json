  },
  "exports": {
    ".": "./src/index.ts"
  },
  "optionalDependencies": {
    "castrum": "^0.9.10"
  },
  "devDependencies": {
    "@ignex/test-utils": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
