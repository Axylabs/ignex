{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.ignex",
      "!**/node_modules",
      "!**/.git",
      "!coverage",
      "!repomix-output.txt",
      "!**/project.txt",
      "!**/context.py",
      "!**/views/**/*.html",
      "!**/test/fixtures/client-types",
      "!bench/results",
      "!**/client-dist"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["log", "warn", "error", "info"]
          }
        },
        "noAssignInExpressions": "error",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useNodejsImportProtocol": "warn",
        "useTemplate": "warn",
        "useConst": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error"
      },
      "complexity": {
        "noBannedTypes": "warn",
        "useOptionalChain": "warn",
        "noCommaOperator": "error",
        "noUselessTernary": "error",
        "noUselessCatch": "error",
        "noUselessStringConcat": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
